{
  "name": "4story-portal",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:db": "turbo run build --filter=@4story-portal/shared && npm run test:db -w apps/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.8.3"
  }
}
