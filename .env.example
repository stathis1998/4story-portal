# Copy to .env and fill in. .env is gitignored.

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change-me

# Keep the _TEST copies during development. Point these at TGLOBAL_GSP / TGAME_GSP only to go live.
DB_GLOBAL_NAME=TGLOBAL_GSP_TEST
DB_GAME_NAME=TGAME_GSP_TEST

# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

API_PORT=3000

# GM tools. Comma-separated portal usernames allowed to use the GM teleport tool (case-insensitive). Empty means no GMs.
GM_USERNAMES=moose

# TControlSvr, used to send teleports. Port 3616 must stay firewalled to this machine.
# CONTROL_USER / CONTROL_PASSWORD are a TMANAGER account (see scripts/db/create-portal-manager.sql), 1-50 printable ASCII characters.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=3616
CONTROL_USER=portal
CONTROL_PASSWORD=change-me

# Saved GM locations, relative to the API's working directory. Created on first save.
GM_LOCATIONS_FILE=./data/gm-locations.json

# Only for `npm run import:places -w apps/api`: the Tcd folder of the game client players use.
GAME_TCD_DIR=C:/path/to/client/Tcd
